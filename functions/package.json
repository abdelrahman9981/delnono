{
  "name": "delnono-functions",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc",
    "lint": "tsc -p tsconfig.dev.json",
    "pretest": "npm run build",
    "test": "firebase emulators:exec --only auth,firestore,functions \"mocha\"",
    "seed": "tsx scripts/seed.ts",
    "test:rules": "firebase emulators:exec --only firestore,auth \"mocha --no-config --node-option import=tsx --timeout 20000 'test/rules/**/*.test.ts'\""
  },
  "dependencies": {
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.5",
    "firebase": "^12.19.0",
    "firebase-tools": "^15.34.1",
    "mocha": "^12.0.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
