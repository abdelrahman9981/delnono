rules_version = '2';

// Access contract: specs/001-account-registration/contracts/firestore-access.md.
// Anything not matched below is denied.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function guardianPath() {
      return /databases/$(database)/documents/guardians/$(request.auth.uid);
    }

    function policyPath() {
      return /databases/$(database)/documents/settings/policy;
    }

    // The caller is a registered guardian who has accepted the current policy version (FR-017).
    function consentCurrent() {
      return signedIn()
        && exists(guardianPath())
        && exists(policyPath())
        && get(guardianPath()).data.consentVersion == get(policyPath()).data.currentVersion;
    }

    // Staff (005): a role claim and an active staff/{uid} document, so disabling takes effect at once
    // (research R2). A secretary sees only her clinic (D-47); the doctor every clinic.
    function staffRole() {
      return signedIn() ? request.auth.token.get('role', '') : '';
    }

    function isStaff() {
      let path = /databases/$(database)/documents/staff/$(request.auth.uid);
      return staffRole() in ['doctor', 'secretary'] && exists(path) && get(path).data.active == true;
    }

    function isDoctor() {
      return staffRole() == 'doctor' && isStaff();
    }

    function staffOf(clinicId) {
      return isStaff() && (staffRole() == 'doctor' || request.auth.token.get('clinicId', '') == clinicId);
    }

    match /staff/{uid} {
      allow read: if (isOwner(uid) && staffRole() != '') || isDoctor();
      allow write: if false;
    }

    // Today's queue (005): walk-ins and the day's walk-in switch, read by the clinic's staff.
    match /walkIns/{id} {
      allow read: if staffOf(resource.data.clinicId);
      allow write: if false;
    }
    match /days/{id} {
      allow read: if staffOf(resource.data.clinicId);
      allow write: if false;
    }

    // Tips and videos (005 FR-021): guardians and visitors see published items only.
    match /content/{id} {
      allow read: if resource.data.status == 'published' || isStaff();
      allow write: if false;
    }
    match /followUpDrafts/{id} {
      allow read: if isStaff();
      allow write: if false;
    }

    // Needed before sign-in (code rules, policy text, clinic WhatsApp). Edited by the doctor in 004.
    match /settings/{doc} {
      allow read: if true;
      allow write: if false;
    }

    // The doctor's clinics (004): details, schedule and prices, no personal data. Public for Home
    // (D-09); edited by staff in 005.
    match /clinics/{clinicId} {
      allow read: if true;
      allow write: if false;
    }

    function validGuardianDetails(d) {
      return d.fullName is string && d.fullName.size() >= 2 && d.fullName.size() <= 80
        && d.relation in ['mother', 'father', 'other']
        && (!('email' in d) || d.email == null
            || (d.email is string && d.email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$')));
    }

    // Created and deleted only by functions (completeRegistration, deleteAccount). The guardian may
    // edit their own details, never phone, consentVersion, clinicChildrenPending or lastActiveAt.
    match /guardians/{uid} {
      allow read: if isOwner(uid);
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['fullName', 'relation', 'email', 'preferredClinicId', 'updatedAt'])
        && request.resource.data.updatedAt == request.time
        && validGuardianDetails(request.resource.data)
        // The clinic booking starts with («حسابي»): a clinic id or none.
        && (!('preferredClinicId' in request.resource.data)
            || request.resource.data.preferredClinicId == null
            || (request.resource.data.preferredClinicId is string
                && request.resource.data.preferredClinicId.size() <= 40));
      allow create, delete: if false;

      match /consents/{consentId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }
    }

    function validChildEdit(d) {
      return d.name is string && d.name.size() >= 2 && d.name.size() <= 60
        && (!('allergies' in d) || d.allergies == null
            || (d.allergies is string && d.allergies.size() <= 500));
    }

    // Used the app within settings/auth.reverifyAfterDays (default 90). Older accounts must pass
    // the birth-date re-check before reading child data, since numbers get reassigned (FR-010a).
    function active() {
      let authSettings = /databases/$(database)/documents/settings/auth;
      let days = exists(authSettings) ? get(authSettings).data.get('reverifyAfterDays', 90) : 90;
      let last = get(guardianPath()).data.get('lastActiveAt', null);
      return last != null && last > request.time - duration.value(days, 'd');
    }

    function linkedGuardian(child) {
      return consentCurrent() && child.guardianUid == request.auth.uid && active();
    }

    // Created only by functions (createChild, clinic registration in 004). The linked guardian may
    // edit name and allergies only; birth date and sex are staff-only (FR-023, FR-024).
    match /children/{childId} {
      allow read: if linkedGuardian(resource.data);
      allow update: if linkedGuardian(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['name', 'allergies', 'updatedAt', 'updatedBy'])
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && validChildEdit(request.resource.data);
      allow create, delete: if false;

      // Written only by the onChildUpdated trigger.
      match /history/{entryId} {
        allow read: if linkedGuardian(get(/databases/$(database)/documents/children/$(childId)).data);
        allow write: if false;
      }

      // The medical record (003): read only for the linked guardian; recorded by staff in 004.
      // Staff-only documents below them (visits/{v}/staff, measurements/{m}/changes) match nothing
      // here and stay denied.
      match /measurements/{measurementId} {
        allow read: if linkedGuardian(get(/databases/$(database)/documents/children/$(childId)).data);
        allow write: if false;
      }
      match /doses/{doseId} {
        allow read: if linkedGuardian(get(/databases/$(database)/documents/children/$(childId)).data);
        allow write: if false;
      }
      match /visits/{visitId} {
        allow read: if linkedGuardian(get(/databases/$(database)/documents/children/$(childId)).data);
        allow write: if false;
      }
    }

    // A guardian who may see family data: current consent and recent activity (001, FR-010a).
    function guardianActive() {
      return consentCurrent() && active();
    }

    // Booking (002). The clinic's vaccine list and the places taken per hour (counts only, no
    // personal data) are readable by signed-in users; all writes happen in Cloud Functions.
    match /vaccines/{vaccineId} {
      allow read: if signedIn();
      allow write: if false;
    }
    match /slots/{slotId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Doctor-owned schedule and follow-up lists (003); edited from the dashboard in 004.
    match /vaccineSchedule/{entryId} {
      allow read: if signedIn();
      allow write: if false;
    }
    match /followUp/{bandId} {
      allow read: if signedIn();
      allow write: if false;
    }
    // A guardian's own bookings, with their history; written only by Cloud Functions (002).
    match /bookings/{bookingId} {
      allow read: if (guardianActive() && resource.data.guardianUid == request.auth.uid)
        || staffOf(resource.data.get('clinicId', ''));
      allow write: if false;

      match /events/{eventId} {
        allow read: if guardianActive()
          && get(/databases/$(database)/documents/bookings/$(bookingId)).data.guardianUid == request.auth.uid;
        allow write: if false;
      }
    }

    // Annual packages (006); read here to show "covered by package".
    match /packages/{packageId} {
      allow read: if (guardianActive() && resource.data.guardianUid == request.auth.uid) || isStaff();
      allow write: if false;
    }

    match /counters/{counterId} {
      allow read, write: if false;
    }
    match /familyQuota/{uid} {
      allow read, write: if false;
    }

    // Server only: written and read by Cloud Functions with the Admin SDK.
    match /clinicGuardians/{phone} {
      allow read, write: if false;
    }
    match /linkAttempts/{phone} {
      allow read, write: if false;
    }
    match /reverifyAttempts/{uid} {
      allow read, write: if false;
    }
    match /smsCounters/{id} {
      allow read, write: if false;
    }
    match /auditLog/{id} {
      // Only the doctor reads the audit log (D-13).
      allow read: if isDoctor();
      allow write: if false;
    }
    match /deletedGuardians/{document=**} {
      allow read, write: if false;
    }
  }
}
